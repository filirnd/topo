[Unit]
Description=Topo Watcher (Tapo doorbell/camera alerts)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@APP_DIR@
# Reuse a saved Topo/Flatpak login session when present.
Environment=XDG_STATE_HOME=%h/.var/app/io.github.filirnd.topo/.local/state
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 @APP_DIR@/tapo_desktop.py --watch --headless
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=graphical-session.target
